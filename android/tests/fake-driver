# A scarletnx-android for test-run-scarletnx.sh: FAKE_SCENARIO picks what each launch does (ok, die-once, stall);
# FAKE_STATE (a folder) keeps the launch count and what the launch saw (its arguments, its environment, the mode file).
pkg=org.scarletnx.edenprobe
n=$(($(cat "$FAKE_STATE/launches" 2> /dev/null || echo 0) + 1))
echo $n > "$FAKE_STATE/launches"
root=$XDG_DATA_HOME/scarletnx/android/data/$pkg/external/files/edenprobe
{
    echo "args $*"
    echo "DISPLAY=${DISPLAY-unset} WAYLAND_DISPLAY=${WAYLAND_DISPLAY-unset}"
    echo "XDG_DATA_HOME=$XDG_DATA_HOME"
    echo "mode $(cat "$root/mode" 2> /dev/null)"
} > "$FAKE_STATE/seen-$n"
run=$root/runs/fixture
mkdir -p "$run"
echo "runs/fixture" > "$root/last-run"
printf 'launch\n' >> "$run/journal"
if [ "$FAKE_SCENARIO" = die-once ] && [ $n = 1 ]; then
    head -n 4 "$FAKE_REPORT" > "$run/report.jsonl"
    echo "what a JVM leaves in its working folder when it crashes" > "hs_err_pid$$.log"
    echo "I/edenprobe: $(sed -n 4p "$FAKE_REPORT")" >&2
    echo "E/AndroidRuntime: FATAL EXCEPTION: main" >&2
    exit 1
fi
if [ "$FAKE_SCENARIO" = stall ] && [ $n = 1 ]; then
    sleep 60
    exit 0
fi
cp "$FAKE_REPORT" "$run/report.jsonl"
echo "I/edenprobe: $(tail -n 1 "$FAKE_REPORT")" >&2
echo "I/edenprobe: EDENPROBE DONE passed=1 failed=1 skipped=1 crashed=0" >&2
exit 0
