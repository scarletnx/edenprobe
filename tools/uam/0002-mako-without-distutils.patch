uam's build checks for mako with distutils, which Python 3.12 took out: the same check without it.

diff --git a/meson.build b/meson.build
index 1486cbc..04b2428 100644
--- a/meson.build
+++ b/meson.build
@@ -8,9 +8,8 @@ prog_python = import('python3').find_python()
 has_mako = run_command(
 	prog_python, '-c',
 	'''
-from distutils.version import StrictVersion
 import mako
-assert StrictVersion(mako.__version__) > StrictVersion("0.8.0")
+assert tuple(int(x) for x in mako.__version__.split('.')[:2]) > (0, 8)
 	''')
 if has_mako.returncode() != 0
 	error('Python (3.x) mako module >= 0.8.0 required to build uam.')
